{
  "name": "@kpu/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Capacitor shell that wraps @kpu/web for iOS and Android. See README.md.",
  "scripts": {
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "build:web": "pnpm --filter @kpu/web build",
    "run:ios": "cap run ios",
    "run:android": "cap run android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/camera": "6.1.2",
    "@capacitor/core": "6.2.0",
    "@capacitor/haptics": "6.0.2",
    "@capacitor/ios": "6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "@kpu/config": "workspace:*",
    "@types/node": "22.10.5",
    "typescript": "5.7.2"
  }
}
