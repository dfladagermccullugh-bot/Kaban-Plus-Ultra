# syntax=docker/dockerfile:1.7
#
# Multi-stage build for the Kaban Plus Ultra Next.js app. Produces a slim
# Alpine runtime image (~200 MB) that runs `next start` from the
# `output: 'standalone'` artifact emitted by `next build`.
#
# Build context = repo root. Single-arch (host arch) build:
#   docker build -f docker/Dockerfile.web -t kaban-web .
#
# Multi-arch (linux/amd64 + linux/arm64) build via buildx — see
# scripts/build-multiarch.sh and docs/SELF_HOSTING.md → "ARM64 / Raspberry
# Pi". `node:22-alpine` is itself a multi-arch manifest, so a bare `FROM`
# resolves to the host arch under the default builder and to each requested
# `--platform` under buildx — no explicit `--platform=$TARGETPLATFORM` needed
# (a pre-FROM global ARG is empty under `docker compose up --build` and the
# platform parser then rejects ""). pnpm + Next pull architecture-appropriate
# prebuilt binaries (sharp, esbuild) on install for whichever arch the base
# resolved to.

# ── 1. dependencies ─────────────────────────────────────────────────────────
FROM node:22-alpine AS deps
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/web/package.json            apps/web/package.json
COPY apps/mobile/package.json         apps/mobile/package.json
COPY packages/core/package.json       packages/core/package.json
COPY packages/db/package.json         packages/db/package.json
COPY packages/ui/package.json         packages/ui/package.json
RUN pnpm install --frozen-lockfile

# ── 2. build ────────────────────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/apps/web/node_modules            ./apps/web/node_modules
COPY --from=deps /repo/packages/core/node_modules       ./packages/core/node_modules
COPY --from=deps /repo/packages/db/node_modules         ./packages/db/node_modules
COPY --from=deps /repo/packages/ui/node_modules         ./packages/ui/node_modules
COPY . .
# Publishable env (NEXT_PUBLIC_*) must exist at build time. Service-role keys
# stay out of the image — they're read at runtime from the container env.
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SITE_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
RUN pnpm --filter @kpu/web build

# ── 3. runtime ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0
RUN addgroup -S kaban && adduser -S kaban -G kaban
COPY --from=build --chown=kaban:kaban /repo/apps/web/.next/standalone ./
COPY --from=build --chown=kaban:kaban /repo/apps/web/.next/static     ./apps/web/.next/static
COPY --from=build --chown=kaban:kaban /repo/apps/web/public           ./apps/web/public
USER kaban
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
