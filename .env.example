# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# First-run wizard token (server only).
# Set to a long random string; the /setup route is only reachable when
# `?t=<token>` matches. install-kaban.sh generates one per deploy.
SETUP_TOKEN=

# Auth providers (optional; configure in Supabase dashboard)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Sentry (optional)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
