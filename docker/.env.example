# Copy to docker/.env and fill in real values before `docker compose up`.
# Never commit docker/.env — it lives in .gitignore via the top-level
# `.env` rule.

# ── Public — baked into the Next.js bundle at build time ────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...           # anon JWT
NEXT_PUBLIC_SITE_URL=https://kaban.example.com

# ── Server-only — read at runtime by the container, never shipped to the
#    browser. Required for invite-by-email + audit-events writer. ────────────
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...               # service_role JWT

# ── Caddy ───────────────────────────────────────────────────────────────────
# Public hostname Caddy will serve. Set to `localhost` for a local-only
# self-signed run; set to a real DNS name to get a Let's Encrypt cert.
KABAN_HOST=kaban.example.com

# ── Optional: stand-alone Postgres (only if you uncomment the `postgres`
#    service in docker-compose.yml). For the full Supabase stack, follow
#    the upstream `supabase/supabase` compose and ignore this. ───────────────
# POSTGRES_PASSWORD=change-me-pls
