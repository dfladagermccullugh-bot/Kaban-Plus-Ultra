# Auto-HTTPS reverse proxy in front of kaban-web. Set KABAN_HOST in `.env`
# to your real hostname; with KABAN_SCHEME=https (the default) Caddy
# provisions a Let's Encrypt cert for it.
#
# For a local-only run, install-kaban.sh sets KABAN_SCHEME=http when
# KABAN_HOST is localhost/127.0.0.1. An explicit `http://` site address
# disables automatic HTTPS, so Caddy serves plain HTTP on :80 with no
# 308 → https redirect and no self-signed-cert click-through. See
# docs/DECISIONS/0022.

{$KABAN_SCHEME:https}://{$KABAN_HOST} {
	encode zstd gzip
	@hostHealth path /
	reverse_proxy web:3000

	# Long-cache the Next.js static asset chunks (immutable, hashed).
	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	# HSTS + nosniff. CSP is set in middleware.ts.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}
}
