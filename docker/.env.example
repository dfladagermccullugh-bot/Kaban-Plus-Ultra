# Copy to docker/.env and fill in real values before `docker compose up`.
# Never commit docker/.env — it lives in .gitignore via the top-level
# `.env` rule.
#
# The `scripts/install-kaban.sh` one-liner generates this file for you
# (random POSTGRES_PASSWORD / JWT_SECRET / DASHBOARD_PASSWORD, signed JWTs
# derived from JWT_SECRET, URLs derived from KABAN_HOST). Edit by hand only
# if you know what you're doing.

# ── Caddy ───────────────────────────────────────────────────────────────────
# Public hostname Caddy serves. Set to `localhost` for a local-only
# self-signed run; set to a real DNS name to get a Let's Encrypt cert.
KABAN_HOST=kaban.example.com

# ── Kaban web — public (baked into the Next.js bundle at build time) ────────
NEXT_PUBLIC_SUPABASE_URL=https://kaban.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...           # anon JWT (same as ANON_KEY below for self-host)
NEXT_PUBLIC_SITE_URL=https://kaban.example.com

# ── Kaban web — server-only — read at runtime by the container, never
#    shipped to the browser. Required for invite-by-email + audit-events
#    writer. (Same as SERVICE_ROLE_KEY below for self-host.) ─────────────────
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...               # service_role JWT

# ── Supabase self-host secrets ─────────────────────────────────────────────
# Used by every service in the upstream supabase/supabase compose
# (docker/supabase/upstream/docker/docker-compose.yml). For hosted-Supabase
# mode (`docker-compose.yml` only, without `kaban-stack.yml`) you can leave
# these blank.
POSTGRES_PASSWORD=change-me-please-and-keep-this-secret
JWT_SECRET=at-least-32-chars-long-rotate-and-everything-breaks
ANON_KEY=eyJhbGciOi...                                # HS256(JWT_SECRET, {role: "anon"})
SERVICE_ROLE_KEY=eyJhbGciOi...                        # HS256(JWT_SECRET, {role: "service_role"})
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me

# ── Supabase Postgres (defaults — only change if you also adjust the
#    upstream compose) ─────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── Supavisor (Supabase's pooler) ──────────────────────────────────────────
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=kaban
POOLER_DB_POOL_SIZE=5

# ── Kong (Supabase's API gateway) ──────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ── Auth (GoTrue) ──────────────────────────────────────────────────────────
# Public URL the auth server thinks it's reachable on. Magic-link emails
# embed this URL.
SITE_URL=https://kaban.example.com
API_EXTERNAL_URL=https://kaban.example.com
SUPABASE_PUBLIC_URL=https://kaban.example.com
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
MAILER_AUTOCONFIRM=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# ── SMTP (magic links) — point at your provider ────────────────────────────
SMTP_ADMIN_EMAIL=admin@kaban.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Kaban Plus Ultra

# ── Studio (the Supabase admin UI mounted at /project) ─────────────────────
STUDIO_DEFAULT_ORGANIZATION=Kaban
STUDIO_DEFAULT_PROJECT=Kaban Plus Ultra
STUDIO_PORT=3000

# ── Functions (Edge) ───────────────────────────────────────────────────────
FUNCTIONS_VERIFY_JWT=false

# ── Analytics (Logflare) ───────────────────────────────────────────────────
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=

# ── Imgproxy ───────────────────────────────────────────────────────────────
IMGPROXY_ENABLE_WEBP_DETECTION=true

# ── Image storage backend ──────────────────────────────────────────────────
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# ── OpenAI (used by Supabase Studio's SQL editor; optional) ────────────────
OPENAI_API_KEY=
